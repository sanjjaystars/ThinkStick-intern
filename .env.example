# Supabase — get these from: https://app.supabase.com → Your Project → Settings → API
SUPABASE_URL=your_supabase_rest_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Resend — get this from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email address to receive application notifications
NOTIFY_EMAIL=your_email@example.com
